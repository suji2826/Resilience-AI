# ============================================================
# RESILIENCE AI — Backend Environment Configuration Example
# ============================================================

# Application
PROJECT_NAME="RESILIENCE AI"
ENV="development"

# Database
DATABASE_URL="sqlite:///./resilience.db"

# Security & Authentication
JWT_SECRET="resilience-ai-super-secret-key-change-in-production-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Google AI Studio / Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Google Cloud Deployment
GOOGLE_CLOUD_PROJECT="resilience-ai-hackathon"
GOOGLE_CLOUD_REGION="asia-south1"
