# ============================================================
# RESILIENCE AI — Environment Configuration Template (.env.example)
# ============================================================

# Environment: 'development' | 'staging' | 'production'
ENV="development"
PROJECT_NAME="RESILIENCE AI"
API_V1_STR="/api"

# ------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------
# Development (Local SQLite):
DATABASE_URL="sqlite:///./resilience.db"

# Production (Google Cloud SQL PostgreSQL Unix Socket format):
# Connects directly via Cloud Run Cloud SQL instance connection
# DATABASE_URL="postgresql://resilience_admin:STRONG_PASSWORD@/resilience_prod?host=/cloudsql/YOUR_GCP_PROJECT:asia-south1:resilience-db-instance"

# ------------------------------------------------------------
# Security & Authentication
# ------------------------------------------------------------
# In production, store in Google Secret Manager as 'resilience-jwt-secret'
JWT_SECRET="resilience-ai-super-secret-key-change-in-production-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ------------------------------------------------------------
# Google AI Studio / Gemini API
# ------------------------------------------------------------
# In production, store in Google Secret Manager as 'gemini-api-key-secret'
GEMINI_API_KEY="your-gemini-api-key-from-aistudio"
GEMINI_MODEL="gemini-2.5-flash"

# ------------------------------------------------------------
# Google Cloud Platform Deployment
# ------------------------------------------------------------
GOOGLE_CLOUD_PROJECT="resilience-ai-hackathon"
GOOGLE_CLOUD_REGION="asia-south1"
CLOUD_RUN_SERVICE_BACKEND="resilience-ai-backend"
CLOUD_RUN_SERVICE_FRONTEND="resilience-ai-frontend"
CLOUD_SQL_INSTANCE="YOUR_GCP_PROJECT:asia-south1:resilience-db-instance"

# ------------------------------------------------------------
# CORS & Networking
# ------------------------------------------------------------
# Comma-separated list of allowed frontend origins (no trailing slashes)
BACKEND_CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
FRONTEND_URL="http://localhost:5173"

# Frontend build-time API base URL (used during docker build for Vite)
# In production: https://resilience-ai-backend-<hash>-el.a.run.app
VITE_API_BASE_URL=""

# ------------------------------------------------------------
# Database Seeding & Operational Controls
# ------------------------------------------------------------
# Set SEED_DB="true" for first-time production initialization, "false" for cold starts
SEED_DB="false"
LOG_LEVEL="INFO"
